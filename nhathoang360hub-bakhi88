-- [2] HÀM CHẠY SCRIPT
local function HandleScriptExecution(scriptName, scriptUrl)
    if not isKeyVerified then
        Fluent:Notify({
            Title = "Locked!",
            Content = "Please verify your key in the 'Key System' tab first!",
            Duration = 4
        })
        return
    end

    if activeScriptRunning then
        Window:Dialog({
            Title = "Switch Script",
            Content = "Bạn có muốn tắt script này để chọn script khác không?",
            Buttons = {
                {
                    Title = "Có",
                    Callback = function()
                        activeScriptRunning = false
                        Fluent:Notify({ Title = "Reset", Content = "Đã chọn đổi script. Đang tải " .. scriptName .. "...", Duration = 3 })
                        task.spawn(function()
                            local successExec, err = pcall(function() loadstring(game:HttpGet(scriptUrl))() end)
                            if successExec then
                                activeScriptRunning = true
                                Fluent:Notify({ Title = "Thành Công", Content = "Đã bật " .. scriptName, Duration = 3 })
                            else
                                Fluent:Notify({ Title = "Lỗi", Content = "Không thể chạy script: " .. tostring(err), Duration = 4 })
                            end
                        end)
                    end
                },
                { Title = "Không", Callback = function() end }
            }
        })
    else
        Fluent:Notify({ Title = "Đang Tải", Content = "Đang tải " .. scriptName .. "...", Duration = 3 })
        task.spawn(function()
            local successExec, err = pcall(function() loadstring(game:HttpGet(scriptUrl))() end)
            if successExec then
                activeScriptRunning = true
                Fluent:Notify({ Title = "Thành Công", Content = "Đã bật " .. scriptName, Duration = 3 })
            else
                Fluent:Notify({ Title = "Lỗi", Content = "Không thể chạy script: " .. tostring(err), Duration = 4 })
            end
        end)
    end
end

