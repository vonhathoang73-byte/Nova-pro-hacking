-- ================== Ngày hôm nay (GMT+7) ==================
local function getToday()
    local d = os.date("*t", os.time() + 7 * 60 * 60)
    return string.format("%02d%02d%04d", d.day, d.month, d.year)
end
local TODAY = getToday()

-- ================== Tải script từ xa ==================
local function loadRemote()
    task.spawn(function()
        local ok, err = pcall(function()
            return loadstring(game:HttpGet(REMOTE_URL))()
        end)
        if not ok then
            warn("[Nhật Hoàng System] Lỗi load script:", err)
        end
    end)
end

-- ================== Kiểm tra key đã lưu ==================
local function isSaved()
    if readfile and isfile and isfile(SAVE_FILE) then
        local ok, content = pcall(readfile, SAVE_FILE)
        if ok and content == TODAY then return true end
    end
    return false
end

if isSaved() then
    print("[Nhật Hoàng System]: Key hôm nay đã được xác thực trước đó. Đang vào game...")
    loadRemote()
    return
end

