--[[ OMG Hub | vonhathoang x OMG | Animated UI + FPS Boost ]]
-- Boss man, animated title, smooth tweens, and a lag reducer that actually helps.

local ReduxV1 = loadstring(game:HttpGet("https://raw.githubusercontent.com/Sealient/ReduxV1/refs/heads/main/ReduxV1.lua"))()
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")

-- === KEY CONFIG ===
local VALID_KEYS = {
    ["OMG-FREE-2026"] = true,
    ["DELTA-VIP-ACCESS"] = true,
    ["BOSS-MAN-KEY"] = true,
}

-- === ANIMATED TITLE (rainbow gradient pulse) ===
local UI = ReduxV1:CreateMain("vonhathoang x OMG Hub")
local KeyTab = UI:CreateTab("Access")

local titleLabel = KeyTab:CreateLabel("vonhathoang x OMG Hub")
local hue = 0
local titleConn = RunService.RenderStepped:Connect(function(dt)
    hue = (hue + dt * 0.35) % 1
    local color = Color3.fromHSV(hue, 0.85, 1)
    pcall(function()
        titleLabel:SetColor(color)
    end)
end)

-- === FPS / LAG OPTIMIZER ===
local function applyFPSBoost()
    pcall(function()
        -- Kill heavy post effects
        for _, v in ipairs(Lighting:GetChildren()) do
            if v:IsA("BlurEffect") or v:IsA("BloomEffect")
            or v:IsA("SunRaysEffect") or v:IsA("DepthOfFieldEffect") then
                v.Enabled = false
            end
        end
        -- Lower global quality
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01

        -- Cull distant particles & shadows
        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Smoke") or d:IsA("Fire") then
                d.Enabled = false
            elseif d:IsA("BasePart") then
                d.CastShadow = false
            end
        end

        -- Nuke terrain detail if present
        local terrain = workspace:FindFirstChildOfClass("Terrain")
        if terrain then
            terrain.WaterWaveSize = 0
            terrain.WaterWaveSpeed = 0
            terrain.WaterReflectance = 0
        end
    end)
end

-- === INPUT + VERIFY ===
KeyTab:CreateInput("Enter Key", "Paste your key here...", function(text)
    _G.OMG_KeyInput = text
end)

KeyTab:CreateToggle("FPS Boost", true, function(state)
    _G.OMG_FPSBoost = state
    if state then applyFPSBoost() end
end)

KeyTab:CreateButton("Verify & Launch", "Checks key, boosts FPS, loads OMG Hub", function()
    local input = _G.OMG_KeyInput

    if not input or input == "" then
        ReduxV1:Notify("No Key", "Fuck, you didn't type anything. Try again.", 3)
        return
    end

    if not VALID_KEYS[input] then
        ReduxV1:Notify("Invalid Key", "That key ain't it, boss man. Try again.", 3)
        return
    end

    ReduxV1:Notify("Access Granted", "Key verified. Boosting FPS and loading OMG Hub...", 5)

    if _G.OMG_FPSBoost ~= false then applyFPSBoost() end

    -- Kill the animation loop so it stops burning frames once we launch
    if titleConn then titleConn:Disconnect() end

    local LoaderURL = "https://raw.githubusercontent.com/Omgshit/Scripts/main/MainLoader.lua"
    local ok, raw = pcall(function() return game:HttpGet(LoaderURL) end)

    if ok and raw and #raw > 0 then
        local fn, err = loadstring(raw)
        if fn then
            pcall(fn)
        else
            warn("[OMG Hub] Loadstring parse failed: " .. tostring(err))
        end
    else
        warn("[OMG Hub] Loader fetch failed. Check executor HTTP.")
    end
end)

KeyTab:CreateParagraph(
    "Key Info",
    "Free keys: OMG-FREE-2026 | DELTA-VIP-ACCESS | BOSS-MAN-KEY\nAnimated title + FPS Boost. No school-bus 'documented' bullshit."
)
