-- ================== Hàm phụ trợ ==================

local function refreshTexts()
    local t = I18N[LANG]
    title.Text             = t.Title
    keyBox.PlaceholderText = t.Placeholder
    getBtn.Text            = t.GetKey
    chkBtn.Text            = t.CheckKey
    statusLbl.Text         = t.DefaultStatus
    dcSub.Text             = t.DiscordSub
    ttSub.Text             = t.TikTokSub
    dcCopy.Text            = t.CopyBtn
    ttCopy.Text            = t.CopyBtn
    langBtn.Text           = t.LangToggleText
end

local function clickAnim(btn)
    local s, p = btn.Size, btn.Position
    local s2 = UDim2.new(s.X.Scale, s.X.Offset - 2, s.Y.Scale, s.Y.Offset - 2)
    local p2 = UDim2.new(p.X.Scale, p.X.Offset + 1, p.Y.Scale, p.Y.Offset + 1)
    local t1 = TweenService:Create(btn,
        TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { Size = s2, Position = p2 })
    local t2 = TweenService:Create(btn,
        TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        { Size = s, Position = p })
    t1:Play()
    t1.Completed:Connect(function() t2:Play() end)
end

local function copyText(txt)
    if setclipboard then setclipboard(txt)
    elseif toclipboard then toclipboard(txt) end
end

local function closeGui()
    local ti = TweenInfo.new(0.35, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out)
    for _, obj in ipairs(main:GetDescendants()) do
        if obj:IsA("TextLabel") then
            TweenService:Create(obj, ti, { TextTransparency = 1 }):Play()
        elseif obj:IsA("TextButton") or obj:IsA("TextBox") then
            TweenService:Create(obj, ti, { TextTransparency = 1, BackgroundTransparency = 1 }):Play()
        elseif obj:IsA("Frame") then
            TweenService:Create(obj, ti, { BackgroundTransparency = 1, BorderSizePixel = 0 }):Play()
        elseif obj:IsA("ImageLabel") then
            TweenService:Create(obj, ti, { ImageTransparency = 1 }):Play()
        elseif obj:IsA("UIStroke") then
            TweenService:Create(obj, ti, { Transparency = 1 }):Play()
        end
    end
    task.wait(0.35)
    TweenService:Create(main, ti, { Size = UDim2.new(0.5, 0, 0.55, 0), BackgroundTransparency = 1 }):Play()
    TweenService:Create(stroke, ti, { Transparency = 1 }):Play()
    task.wait(0.35)
    gui:Destroy()
end

